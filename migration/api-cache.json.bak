  "gb:naming and necessity|saul a kripke": {
    "google_books_id": "9vvAlOBfq0kC",
    "google_books_title": "Naming and Necessity",
    "google_books_author": "Saul A. Kripke",
    "google_books_publisher": "Harvard University Press",
    "google_books_year": "1980",
    "google_books_isbn10": "0674598466",
