  "gb:proofs for eternity creation and the existence of god|herbert a davidson": {
    "google_books_id": "QLMEAQAAIAAJ",
    "google_books_title": "Proofs for Eternity, Creation, and the Existence of God in Medieval Islamic and Jewish Philosophy",
