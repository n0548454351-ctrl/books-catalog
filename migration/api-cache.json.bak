  "gb:the nation the law and the king|jenny graham": {
    "google_books_id": "x2pnAAAAMAAJ",
    "google_books_title": "The Nation, the Law, and the King",
    "google_books_author": "Jenny Graham",
    "google_books_publisher": "",
